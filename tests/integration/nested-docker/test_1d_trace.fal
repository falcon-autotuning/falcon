import (
  "github.com/falcon-autotuning/std-lib@v1.2.4/testing"
  "github.com/falcon-autotuning/std-lib@v1.2.4/hub"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/communications/messages/measurementRequest"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/communications/messages/measurementResponse"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/communications/messages/settingRequest"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/instrumentInterfaces/names/ports"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/instrumentInterfaces/names/instrumentPort"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/instrumentInterfaces/waveform"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/instrumentInterfaces/portTransforms/portTransform"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/instrumentInterfaces/portTransforms/portTransforms"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/math/quantity"
  "github.com/falcon-autotuning/std-lib@v1.2.4/collections/map"
  "github.com/falcon-autotuning/std-lib@v1.2.4/collections/array"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/math/domains/domain"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/math/domains/labelledDomain"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/math/arrays/labelledArrays"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/math/arrays/labelledMeasuredArray"
  "github.com/falcon-autotuning/std-lib@v1.2.4/falconCore/math/domains/coupledLabelledDomain"
)


autotuner Integration1DTraceTest -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_1d_measurement (TestRunner runner, TestContext t) {
        Ports knobs; 
        Ports meters; 
        Ports settings;
        knobs, meters, settings = RequestPortPayload(10000);

        // Construct port query for number of bins with O1
        PortQuery queryo1 = PortQuery.New();
        queryo1.SetConnection(Connection.NewOhmic("O1"));
        queryo1.SetInstrument(Instrument.NewAmnmeter());
        queryo1.SetCharacteristic(Characteristic.NewNumberOfSamples());
        // NOTE: should check read/write access

        // Check if match 
        Error err = settings.IsQueryMatch(queryo1);
        if (err != nil) {
            t.ExpectTrue(err == nil, "err detected from query match");
            -> __end(runner, t);
        }
        InstrumentPort port = settings.FindQueryMatch(queryo1);
        Quantity numbins = Quantity.New(10.0, SymbolUnit.Dimensionless());
        Map<InstrumentPort, Quantity> settingsForRequest= Map.New();
        settingsForRequest.Set(port, numbins);

        // Request Setting for number of bins
        Array<InstrumentPort> emptyGetters = Array.New();
        RequestSetting(SettingRequest.New("Setting number of bins for O1", Ports.New(emptyGetters),settingsForRequest), 10000);

        // Construct port query for knob P1 
        PortQuery queryp1 = PortQuery.New();
        queryp1.SetConnection(Connection.NewPlungerGate("P1"));
        queryp1.SetInstrument(Instrument.NewDcVoltageSource());
        queryp1.SetCharacteristic(Characteristic.NewNone());

        // Check if match 
        err = knobs.IsQueryMatch(queryp1);
        if (err != nil) {
            t.ExpectTrue(err == nil, "err detected from query match");
            -> __end(runner, t);
        }
        InstrumentPort p1= knobs.FindQueryMatch(queryp1);

        // Construct port query for meter O1
        PortQuery query = PortQuery.New();
        query.SetConnection(Connection.NewOhmic("O1"));
        query.SetInstrument(Instrument.NewAmnmeter());
        query.SetCharacteristic(Characteristic.NewNone());

        // Check if match 
        err = meters.IsQueryMatch(query);
        if (err != nil) {
            t.ExpectTrue(err == nil, "err detected from query match");
            -> __end(runner, t);
        }
        InstrumentPort o1 = meters.FindQueryMatch(query);

        // Build measurement axes
        Array<LabelledDomain> firstDimension = Array.New();
        firstDimension.PushBack(LabelledDomain.FromPort(0.1, -0.1, p1, true, true));
        CoupledLabelledDomain coupled1d = CoupledLabelledDomain.New(firstDimension);
        Axes<CoupledLabelledDomain> domainAxes = Axes.New();
        domainAxes.PushBack(coupled1d);

        // Build the divisions 
        Axes<int> divisions = Axes.New();
        divisions.PushBack(20);

        // Build the increasing?
        Map<string, bool> firstDimensionIncreasing = Map.New();
        firstDimensionIncreasing.Set("P1", true);
        Axes<Map<string, bool>> increasing = Axes.New();
        increasing.PushBack(firstDimensionIncreasing);

        // Build the domain
        Domain domain = Domain.New(0.0, 1.0, false, false);

        // Build the request pieces 
        Waveform waveform = Waveform.NewCartesianIdentityWaveform(divisions, domainAxes, increasing, domain);
        Array<Waveform> waveforms = Array.New();
        waveforms.PushBack(waveform);
        Array<InstrumentPort> rawGetters = Array.New();
        rawGetters.PushBack(o1);
        Ports getters = Ports.New(rawGetters);
        LabelledDomain timeDomain = LabelledDomain.FromPort(1.0, 0.0, InstrumentPort.NewExecutionClock(), true, true);
        Array<PortTransform> rawtransforms = Array.New();
        PortTransforms transforms = PortTransforms.New(rawtransforms);

        // Dispatch measurement to falcon-instrument-hub over NATS
        measurementResponse::MeasurementResponse resp = RequestMeasurement(MeasurementRequest.New("taking this 1D measurement", waveforms, getters, transforms, timeDomain), 10000);

        LabelledArrays<LabelledMeasuredArray> measurementarrays = resp.Arrays();
        t.ExpectTrue(measurementarrays.IsMeasuredArrays(), "was not measurement arrays");
        t.ExpectTrue(measurementarrays.Size() == 1, "more than 1 measurement array was detected");

        -> __end(runner, t);
    }
}
