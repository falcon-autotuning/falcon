import (
"../../../generic/farray/farray.fal"
"../measuredArray/measuredArray.fal"
"../../../../collections/array/array.fal"
)
ffimport "measured-array-1D-wrapper.cpp" ("-I/opt/falcon/include/") ("-L/opt/falcon/lib" "-lfalcon_core_cpp")
struct MeasuredArray1D {
    routine New (farray::FArray arr) -> (MeasuredArray1D carray)
    routine Add (measuredArray::MeasuredArray other) -> (MeasuredArray1D carray)
    routine Add (farray::FArray other) -> (MeasuredArray1D carray)
    routine Add (int other) -> (MeasuredArray1D carray)
    routine Add (float other) -> (MeasuredArray1D carray)
    routine Minus (measuredArray::MeasuredArray other) -> (MeasuredArray1D carray)
    routine Minus (farray::FArray other) -> (MeasuredArray1D carray)
    routine Minus (int other) -> (MeasuredArray1D carray)
    routine Minus (float other) -> (MeasuredArray1D carray)
    routine Negate -> (MeasuredArray1D carray)
    routine Times (float factor) -> (MeasuredArray1D carray)
    routine Times (int factor) -> (MeasuredArray1D carray)
    routine Divides (float factor) -> (MeasuredArray1D carray)
    routine Divides (int factor) -> (MeasuredArray1D carray)
    routine Power (float exponent) -> (MeasuredArray1D carray)
    routine Abs -> (MeasuredArray1D carray)
    routine Min -> (float min)
    routine GetStart -> (float s)
    routine GetEnd -> (float end)
    routine IsDecreasing -> (bool decreasing)
    routine IsIncreasing -> (bool increasing)
    routine GetDistance -> (float distance)
    routine GetMean -> (float mean)
    routine GetSTD -> (float std)
    routine Reverse -> ()
    routine GetClosestIndex (float value) -> (int index)
    routine EvenDivisions (int divisions) -> (array::Array<farray::FArray> splits)
    // TODO: arraywise min and max
    routine Max -> (float max)
    routine Reshape (array::Array<int> shape) -> (MeasuredArray1D carray)
    routine Flip (int axis) -> (MeasuredArray1D carray)
    routine Gradient (int axis) -> (farray::FArray gradient)
    routine FullGradient -> (array::Array<farray::FArray> gradients)
    routine Equal (MeasuredArray1D other) -> (bool equal)
    routine NotEqual (MeasuredArray1D other) -> (bool notequal)
    routine FromJSON (string json) -> (MeasuredArray1D farray)
    routine ToJSON () -> (string json)
}
