import "../../../../../testing/testing.fal";
import "../../../../../collections/array/array.fal";
import "../ports.fal";
import "../../instrumentPort/instrumentPort.fal";
import "../../../../physics/deviceStructures/connection/connection.fal";
import "../../../../physics/units/symbolUnit/symbolUnit.fal";
import "../../../../../io/io.fal";
import "../../../../../strings/strings.fal";

// ── helpers ───────────────────────────────────────────────────────────────────

routine MakeKnob (string name) -> (InstrumentPort port) {
    Connection c  = Connection.NewPlungerGate(name);
    SymbolUnit v  = SymbolUnit.Volt();
    port          = InstrumentPort.NewKnob(name, c, v, name, "instrument", Instrument.NewDcVoltageSource());
}

routine MakeMeter (string name) -> (InstrumentPort port) {
    Connection c  = Connection.NewOhmic(name);
    SymbolUnit a  = SymbolUnit.Ampere();
    port          = InstrumentPort.NewMeter(name, c, a, name, "other", Instrument.NewAmnmeter());
}

// ─────────────────────────────────────────────────────────────────────────────
// Suite: PortsConstruction
// ─────────────────────────────────────────────────────────────────────────────
autotuner PortsConstruction -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_new_empty (TestRunner runner, TestContext t) {
        Array<InstrumentPort> arr = Array.New();
        Ports p = Ports.New(arr);
        Array<string> names = p.GetDefaultNames();
        Error err = t.ExpectIntEq(0, names.Size(), "Empty Ports has 0 names");
        -> __end(runner, t);
    }

    state test_new_single_knob (TestRunner runner, TestContext t) {
        InstrumentPort knob   = MakeKnob("P1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(knob);
        Ports p               = Ports.New(arr);
        Array<string> names   = p.GetDefaultNames();
        Error err = t.ExpectIntEq(1, names.Size(), "Single-entry Ports has 1 name");
        -> __end(runner, t);
    }

    state test_new_two_ports (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports p           = Ports.New(arr);
        Array<string> names = p.GetDefaultNames();
        Error err = t.ExpectIntEq(2, names.Size(), "Two-entry Ports has 2 names");
        -> __end(runner, t);
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Suite: PortsBulkAccessors
// ─────────────────────────────────────────────────────────────────────────────
autotuner PortsBulkAccessors -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_default_names_values (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports p           = Ports.New(arr);
        Array<string> ns  = p.GetDefaultNames();
        Error err = t.ExpectStrEq("P1", ns.GetIndex(0), "First name is P1");
        err = t.ExpectStrEq("I1", ns.GetIndex(1), "Second name is I1");
        -> __end(runner, t);
    }

    state test_pseudo_names_length (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports p           = Ports.New(arr);
        Array<connection::Connection> cs = p.GetPsuedoNames();
        Error err = t.ExpectIntEq(2, cs.Size(), "GetPsuedoNames length is 2");
        -> __end(runner, t);
    }

    state test_pseudo_names_first (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        Ports p           = Ports.New(arr);
        Array<connection::Connection> cs = p.GetPsuedoNames();
        connection::Connection c0 = cs.GetIndex(0);
        Error err = t.ExpectStrEq("P1", c0.Name(), "First pseudo-name is P1");
        -> __end(runner, t);
    }

    state test_is_knobs_values (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports p        = Ports.New(arr);
        bool ks = p.IsKnobs();
        Error err       = t.ExpectFalse(ks,  "Is knobs and meters");
        -> __end(runner, t);
    }

    state test_is_meters_values (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports p        = Ports.New(arr);
        bool ms = p.IsMeters();
        Error err       = t.ExpectFalse(ms,  "Is knobs and meters");
        -> __end(runner, t);
    }

    state test_ports_array_length (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports p           = Ports.New(arr);
        Array<instrumentPort::InstrumentPort> ps = p.Ports();
        Error err = t.ExpectIntEq(2, ps.Size(), "Ports() returns 2 entries");
        -> __end(runner, t);
    }

    state test_ports_array_first_default_name (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        Ports p           = Ports.New(arr);
        Array<instrumentPort::InstrumentPort> ps = p.Ports();
        instrumentPort::InstrumentPort p0 = ps.GetIndex(0);
        Error err = t.ExpectStrEq("P1", p0.DefaultName(), "First port default name is P1");
        -> __end(runner, t);
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Suite: PortsEquality
// ─────────────────────────────────────────────────────────────────────────────
autotuner PortsEquality -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_equal_same_ports (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports a = Ports.New(arr);
        Ports b = Ports.New(arr);
        Error err = t.ExpectTrue(a.Equal(b), "Same port list gives equal Ports");
        -> __end(runner, t);
    }

    state test_not_equal_different_ports (TestRunner runner, TestContext t) {
        InstrumentPort k1 = MakeKnob("P1");
        InstrumentPort k2 = MakeKnob("P2");
        Array<InstrumentPort> arr1 = Array.New();
        arr1.PushBack(k1);
        Array<InstrumentPort> arr2 = Array.New();
        arr2.PushBack(k2);
        Ports a = Ports.New(arr1);
        Ports b = Ports.New(arr2);
        Error err = t.ExpectTrue(a.NotEqual(b), "Different port lists are not equal");
        -> __end(runner, t);
    }

    state test_equal_false_for_different (TestRunner runner, TestContext t) {
        InstrumentPort k1 = MakeKnob("P1");
        InstrumentPort k2 = MakeKnob("P2");
        Array<InstrumentPort> arr1 = Array.New();
        arr1.PushBack(k1);
        Array<InstrumentPort> arr2 = Array.New();
        arr2.PushBack(k2);
        Ports a = Ports.New(arr1);
        Ports b = Ports.New(arr2);
        Error err = t.ExpectFalse(a.Equal(b), "Equal is false for different Ports");
        -> __end(runner, t);
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Suite: PortsJSON
// ─────────────────────────────────────────────────────────────────────────────
autotuner PortsJSON -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_to_json_non_empty (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        Ports p   = Ports.New(arr);
        string j  = p.ToJSON();
        Error err = t.ExpectStrNe("", j, "ToJSON is non-empty");
        -> __end(runner, t);
    }

    state test_roundtrip (TestRunner runner, TestContext t) {
        InstrumentPort k = MakeKnob("P1");
        InstrumentPort m = MakeMeter("I1");
        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(k);
        arr.PushBack(m);
        Ports orig     = Ports.New(arr);
        string json    = orig.ToJSON();
        Ports restored = Ports.FromJSON(json);
        Error err = t.ExpectTrue(orig.Equal(restored), "FromJSON(ToJSON(ports)) round-trips");
        -> __end(runner, t);
    }
}

autotuner PortsQueryMatching -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_match_default_name (TestRunner runner, TestContext t) {
        InstrumentPort p1 = MakeKnob("P1");
        InstrumentPort p2 = MakeKnob("P2");

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(p1);
        arr.PushBack(p2);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetDefaultName("P2");

        Error err = ports.IsQueryMatch(query);

        Error check = t.ExpectTrue(
            err == nil,
            "Default-name query finds matching port");

        -> __end(runner, t);
    }

    state test_find_default_name_match (TestRunner runner, TestContext t) {
        InstrumentPort p1 = MakeKnob("P1");
        InstrumentPort p2 = MakeKnob("P2");

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(p1);
        arr.PushBack(p2);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetDefaultName("P2");

        InstrumentPort match =
            ports.FindQueryMatch(query);

        Error err = t.ExpectStrEq(
            "P2",
            match.DefaultName(),
            "FindQueryMatch returns correct port");

        -> __end(runner, t);
    }

    state test_match_connection (TestRunner runner, TestContext t) {
        Connection p1conn = Connection.NewPlungerGate("P1");
        Connection p2conn = Connection.NewPlungerGate("P2");

        InstrumentPort p1 =
            InstrumentPort.NewKnob(
                "P1",
                p1conn,
                SymbolUnit.Volt(),
                "p1",
                "",
                Instrument.NewDcVoltageSource());

        InstrumentPort p2 =
            InstrumentPort.NewKnob(
                "P2",
                p2conn,
                SymbolUnit.Volt(),
                "p2",
                "",
                Instrument.NewDcVoltageSource());

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(p1);
        arr.PushBack(p2);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetConnection(p2conn);

        Error err = ports.IsQueryMatch(query);

        Error check = t.ExpectTrue(
            err==nil,
            "Connection query matches");

        -> __end(runner, t);
    }

    state test_match_instrument_type (TestRunner runner, TestContext t) {
        InstrumentPort knob =
            InstrumentPort.NewKnob(
                "P1",
                Connection.NewPlungerGate("P1"),
                SymbolUnit.Volt(),
                "knob",
                "",
                Instrument.NewDcVoltageSource());

        InstrumentPort meter =
            InstrumentPort.NewMeter(
                "I1",
                Connection.NewOhmic("I1"),
                SymbolUnit.Ampere(),
                "meter",
                "",
                Instrument.NewAmnmeter());

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(knob);
        arr.PushBack(meter);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetInstrument(
            Instrument.NewAmnmeter());

        InstrumentPort result =
            ports.FindQueryMatch(query);

        Error err = t.ExpectTrue(
            result.InstrumentType().IsAmnmeter(),
            "Instrument query returns amnmeter");

        -> __end(runner, t);
    }

    state test_match_scope (TestRunner runner, TestContext t) {

        InstrumentPort setting =
            InstrumentPort.NewSetting(
                "sample_rate",
                nil,
                SymbolUnit.Hertz(),
                "rate",
                "",
                Instrument.NewDcVoltageSource(),
                Scope.NewGlobalScope(),
                Access.NewReadWriteAccess(),
                Characteristic.NewSampleRate());

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(setting);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetScope(
            Scope.NewGlobalScope());

        Error err = ports.IsQueryMatch(query);

        Error check = t.ExpectTrue(
            err==nil,
            "Scope query matches");

        -> __end(runner, t);
    }

    state test_match_access (TestRunner runner, TestContext t) {

        InstrumentPort setting =
            InstrumentPort.NewSetting(
                "sample_rate",
                nil,
                SymbolUnit.Hertz(),
                "rate",
                "",
                Instrument.NewDcVoltageSource(),
                Scope.NewLocalScope(),
                Access.NewReadAccess(),
                Characteristic.NewSampleRate());

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(setting);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetAccess(
            Access.NewReadAccess());

        Error err = ports.IsQueryMatch(query);

        Error check = t.ExpectTrue(
            err==nil,
            "Access query matches");

        -> __end(runner, t);
    }

    state test_match_characteristic (TestRunner runner, TestContext t) {

        InstrumentPort setting =
            InstrumentPort.NewSetting(
                "sample_rate",
                nil,
                SymbolUnit.Hertz(),
                "rate",
                "",
                Instrument.NewDcVoltageSource(),
                Scope.NewLocalScope(),
                Access.NewReadWriteAccess(),
                Characteristic.NewSampleRate());

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(setting);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetCharacteristic(
            Characteristic.NewSampleRate());

        InstrumentPort result =
            ports.FindQueryMatch(query);

        Error err = t.ExpectTrue(
            result.Characteristic().IsSampleRate(),
            "Characteristic query returns correct setting");

        -> __end(runner, t);
    }

    state test_no_match_returns_error (TestRunner runner, TestContext t) {
        InstrumentPort p1 = MakeKnob("P1");

        Array<InstrumentPort> arr = Array.New();
        arr.PushBack(p1);

        Ports ports = Ports.New(arr);

        PortQuery query = PortQuery.New();
        query.SetDefaultName("DOES_NOT_EXIST");

        Error err = ports.IsQueryMatch(query);

        Error check = t.ExpectFalse(
            err == nil,
            "Missing query returns error");

        -> __end(runner, t);
    }
}
