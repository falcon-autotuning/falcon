autotuner InstrumentPortEquality -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_equal_same (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort a      = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        InstrumentPort b      = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        Error err = t.ExpectTrue(a.Equal(b), "Same knob ports are equal");
        -> __end(runner, t);
    }

    state test_not_equal_different_name (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        Connection p2         = Connection.NewPlungerGate("P2");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort a      = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        InstrumentPort b      = InstrumentPort.NewKnob("P2", p2, volt, "plunger","", Instrument.NewDcVoltageSource());
        Error err = t.ExpectTrue(a.NotEqual(b), "Different names are not equal");
        -> __end(runner, t);
    }

    state test_knob_not_equal_meter (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort knob   = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        InstrumentPort meter  = InstrumentPort.NewMeter("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        Error err = t.ExpectTrue(knob.NotEqual(meter), "Knob and meter are not equal");
        -> __end(runner, t);
    }

    state test_equal_false_for_different (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        Connection b1         = Connection.NewBarrierGate("B1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort a      = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        InstrumentPort b      = InstrumentPort.NewKnob("B1", b1, volt, "barrier","", Instrument.NewDcVoltageSource());
        Error err = t.ExpectFalse(a.Equal(b), "Equal is false for different ports");
        -> __end(runner, t);
    }
}

autotuner InstrumentPortSettingConstruction -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_setting_default_name (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort port   = InstrumentPort.NewSetting("P1", p1, volt, "setting port","", Instrument.NewDcVoltageSource(), Scope.NewLocalScope(), Access.NewReadAccess(), Characteristic.NewSampleRate());
        Error err = t.ExpectStrEq("P1", port.DefaultName(), "Setting default name is P1");
        -> __end(runner, t);
    }

    state test_setting_is_setting (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort port   = InstrumentPort.NewSetting("P1", p1, volt, "setting port","", Instrument.NewDcVoltageSource(), Scope.NewLocalScope(), Access.NewReadAccess(), Characteristic.NewSampleRate());
        Error err = t.ExpectTrue(port.IsSetting(), "NewSetting port is a setting");
        -> __end(runner, t);
    }

    state test_setting_is_not_knob_nor_meter (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort port   = InstrumentPort.NewSetting("P1", p1, volt, "setting port","", Instrument.NewDcVoltageSource(), Scope.NewLocalScope(), Access.NewReadAccess(), Characteristic.NewSampleRate());
        Error err1 = t.ExpectFalse(port.IsKnob(), "NewSetting port is not a knob");
        Error err2 = t.ExpectFalse(port.IsMeter(), "NewSetting port is not a meter");
        -> __end(runner, t);
    }
}

autotuner InstrumentPortJSON -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_to_json_non_empty (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort port   = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        string json = port.ToJSON();
        Error err = t.ExpectStrNe("", json, "ToJSON is non-empty");
        -> __end(runner, t);
    }

    state test_roundtrip (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort orig   = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        string json           = orig.ToJSON();
        InstrumentPort res    = InstrumentPort.FromJSON(json);
        Error err = t.ExpectTrue(orig.Equal(res), "ToJSON/FromJSON round-trips");
        -> __end(runner, t);
    }

    state test_from_json_default_name (TestRunner runner, TestContext t) {
        Connection p1         = Connection.NewPlungerGate("P1");
        SymbolUnit volt       = SymbolUnit.Volt();
        InstrumentPort orig   = InstrumentPort.NewKnob("P1", p1, volt, "plunger","", Instrument.NewDcVoltageSource());
        string json           = orig.ToJSON();
        InstrumentPort res    = InstrumentPort.FromJSON(json);
        Error err = t.ExpectStrEq("P1", res.DefaultName(), "FromJSON preserves default name");
        -> __end(runner, t);
    }
}

autotuner InstrumentPortMetadataAccessors -> (int passed, int failed) {
    passed = 0; failed = 0;
    start -> __init;

    state test_knob_instrument_type (TestRunner runner, TestContext t) {
        Connection p1       = Connection.NewPlungerGate("P1");
        SymbolUnit volt     = SymbolUnit.Volt();
        Instrument src      = Instrument.NewDcVoltageSource();

        InstrumentPort port =
            InstrumentPort.NewKnob(
                "P1",
                p1,
                volt,
                "plunger gate",
                "",
                src);

        Instrument inst = port.InstrumentType();

        Error err = t.ExpectTrue(
            inst.IsDcVoltageSource(),
            "Knob reports DC voltage source instrument type");

        -> __end(runner, t);
    }

    state test_meter_instrument_type (TestRunner runner, TestContext t) {
        Connection i1       = Connection.NewOhmic("I1");
        SymbolUnit amp      = SymbolUnit.Ampere();
        Instrument meter    = Instrument.NewAmnmeter();

        InstrumentPort port =
            InstrumentPort.NewMeter(
                "I1",
                i1,
                amp,
                "current meter",
                "",
                meter);

        Instrument inst = port.InstrumentType();

        Error err = t.ExpectTrue(
            inst.IsAmnmeter(),
            "Meter reports amnmeter instrument type");

        -> __end(runner, t);
    }

    state test_setting_scope (TestRunner runner, TestContext t) {
        Connection p1           = Connection.NewPlungerGate("P1");
        SymbolUnit volt         = SymbolUnit.Volt();

        Instrument inst         = Instrument.NewDcVoltageSource();
        Scope scope             = Scope.NewGlobalScope();
        Access access           = Access.NewReadWriteAccess();
        Characteristic char     = Characteristic.NewSourceVoltage();

        InstrumentPort port =
            InstrumentPort.NewSetting(
                "P1",
                p1,
                volt,
                "setting port",
                "",
                inst,
                scope,
                access,
                char);

        Scope result = port.Scope();

        Error err = t.ExpectTrue(
            result.IsGlobalScope(),
            "Scope accessor returns Global scope");

        -> __end(runner, t);
    }

    state test_setting_access (TestRunner runner, TestContext t) {
        Connection p1           = Connection.NewPlungerGate("P1");
        SymbolUnit volt         = SymbolUnit.Volt();

        Instrument inst         = Instrument.NewDcVoltageSource();
        Scope scope             = Scope.NewLocalScope();
        Access access           = Access.NewWriteAccess();
        Characteristic char     = Characteristic.NewSourceVoltage();

        InstrumentPort port =
            InstrumentPort.NewSetting(
                "P1",
                p1,
                volt,
                "setting port",
                "",
                inst,
                scope,
                access,
                char);

        Access result = port.Access();

        Error err = t.ExpectTrue(
            result.IsWriteAccess(),
            "Access accessor returns Write access");

        -> __end(runner, t);
    }

    state test_setting_characteristic (TestRunner runner, TestContext t) {
        Connection p1           = Connection.NewPlungerGate("P1");
        SymbolUnit volt         = SymbolUnit.Volt();

        Instrument inst         = Instrument.NewDcVoltageSource();
        Scope scope             = Scope.NewLocalScope();
        Access access           = Access.NewReadWriteAccess();
        Characteristic char     = Characteristic.NewSourceVoltage();

        InstrumentPort port =
            InstrumentPort.NewSetting(
                "P1",
                p1,
                volt,
                "setting port",
                "",
                inst,
                scope,
                access,
                char);

        Characteristic result = port.Characteristic();

        Error err = t.ExpectTrue(
            result.IsSourceVoltage(),
            "Characteristic accessor returns SourceVoltage");

        -> __end(runner, t);
    }

    state test_setting_all_metadata_roundtrip (TestRunner runner, TestContext t) {
        Connection p1               = Connection.NewPlungerGate("P1");
        SymbolUnit volt             = SymbolUnit.Volt();

        Instrument inst             = Instrument.NewDcVoltageSource();
        Scope scope                 = Scope.NewGlobalScope();
        Access access               = Access.NewReadAccess();
        Characteristic char         = Characteristic.NewMaxSourceVoltage();

        InstrumentPort port =
            InstrumentPort.NewSetting(
                "P1",
                p1,
                volt,
                "setting port",
                "",
                inst,
                scope,
                access,
                char);

        Error err1 = t.ExpectTrue(
            port.InstrumentType().IsDcVoltageSource(),
            "Instrument type preserved");

        Error err2 = t.ExpectTrue(
            port.Scope().IsGlobalScope(),
            "Scope preserved");

        Error err3 = t.ExpectTrue(
            port.Access().IsReadAccess(),
            "Access preserved");

        Error err4 = t.ExpectTrue(
            port.Characteristic().IsMaxSourceVoltage(),
            "Characteristic preserved");

        -> __end(runner, t);
    }
}
